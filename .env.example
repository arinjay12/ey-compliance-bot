# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.
#
# Gmail App Password (NOT your normal password): myaccount.google.com ->
# Security -> 2-Step Verification -> App Passwords.

EY_BOT_SENDER_EMAIL=your_gmail@gmail.com
EY_BOT_SENDER_PASSWORD=your_16_char_app_password
EY_BOT_RECEIVER_EMAIL=recipient@example.com
